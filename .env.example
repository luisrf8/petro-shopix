APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=shopix-local
PUSHER_APP_KEY=shopix-key
PUSHER_APP_SECRET=shopix-secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http

GOOGLE_DRIVE_PROJECT_ID=tu-proyecto-id
GOOGLE_DRIVE_CLIENT_ID=el-id-del-json
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=storage/app/google-auth.json
GOOGLE_DRIVE_FOLDER_ID=id_de_la_carpeta_compartida

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GEMINI_API_KEY=
GEMINI_PROJECT=
GEMINI_PROJECT_NUMBER=
GEMINI_LOCATION=us-central1
GEMINI_CREDENTIALS_PATH=
GEMINI_IMAGE_MODEL=imagen-3.0
GEMINI_IMAGE_FALLBACK_MODELS=gemini-2.0-flash-preview-image-generation,gemini-2.0-flash-exp-image-generation

GEMINI_TEXT_MODEL=gemini-2.5-flash

# Para usar Google Drive en todas las imágenes del sistema:
# IMAGE_STORAGE_PROVIDER=google_drive
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_LOCAL_DISK=public
GOOGLE_DRIVE_CREDENTIALS_PATH=storage/app/google-auth.json

MODULE_HELP_ENABLED=false

# The Factory HKA (Facturacion digital - ambiente demo)
TFHKA_BASE_URL=https://demoemisionv2.thefactoryhka.com.ve
TFHKA_USER=
TFHKA_PASSWORD=
# Alias opcionales por si recibes credenciales como TokenUsuario/TokenPassword
TFHKA_TOKEN_USER=
TFHKA_TOKEN_PASSWORD=
TFHKA_SERIE=
TFHKA_DOCUMENT_TYPE=01
TFHKA_SALE_TYPE=Interna
TFHKA_PAYMENT_TYPE=Inmediato
TFHKA_BRANCH=0001
TFHKA_CURRENCY=BSD
TFHKA_FOREIGN_CURRENCY=USD
TFHKA_EXCHANGE_RATE=1
TFHKA_AUTO_NEXT_NUMBER=true
TFHKA_TIMEOUT=25
TFHKA_VERIFY_SSL=true

GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI
FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET
FACEBOOK_REDIRECT_URI
APPLE_CLIENT_ID
APPLE_CLIENT_SECRET
APPLE_REDIRECT_URI

# WhatsApp Cloud API (envio de documentos PDF)
WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=58
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=